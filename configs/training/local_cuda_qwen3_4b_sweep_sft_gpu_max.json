{
  "base_model": "Qwen/Qwen3-4B",
  "output_dir": "model/artifacts/qwen3-4b-sweep-sft-gpu-max",
  "add_structural_special_tokens": false,
  "dataset": {
    "train_path": "data/training/qwen3_4b_sweep_sft/train.jsonl",
    "validation_path": "data/training/qwen3_4b_sweep_sft/validation.jsonl",
    "text_field": "training_text",
    "format": "json"
  },
  "training": {
    "max_steps": 1200,
    "max_wall_time_minutes": 60,
    "num_train_epochs": 5,
    "learning_rate": 0.00015,
    "sequence_length": 768,
    "per_device_train_batch_size": 2,
    "gradient_accumulation_steps": 2,
    "lora_rank": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.05,
    "max_train_records": null,
    "max_validation_records": null,
    "subset_shuffle_seed": 20260701,
    "tokenize_num_proc": 6,
    "tokenized_cache_dir": "data/training/tokenized_cache/qwen3_4b_sweep_sft_seq768",
    "dataloader_num_workers": 0,
    "dataloader_pin_memory": true,
    "group_by_length": true,
    "timing_log_steps": 10,
    "save_steps": 100,
    "save_total_limit": 3,
    "gradient_checkpointing": false,
    "gradient_checkpointing_kwargs": {
      "use_reentrant": false
    },
    "bf16": true,
    "load_in_4bit": true,
    "allow_tf32": true,
    "float32_matmul_precision": "high",
    "cudnn_benchmark": true,
    "attn_implementation": "sdpa",
    "enable_flash_sdp": true,
    "enable_mem_efficient_sdp": true,
    "optim": "paged_adamw_8bit",
    "max_grad_norm": 0.3,
    "lr_scheduler_type": "cosine",
    "warmup_ratio": 0.03
  }
}
