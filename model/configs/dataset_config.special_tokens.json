{
  "source": "data/model_ready/rap_lyrics_training_dataset.parquet",
  "output_dir": "model/data_special_tokens",
  "split": {
    "train": 0.98,
    "validation": 0.01,
    "test": 0.01
  },
  "random_seed": 42,
  "architecture_seed_path": "model/configs/lyrical_architecture_seeds.json",
  "verse_section_source": "model/data/verse_sections.parquet",
  "section_verse_min_bars": 10,
  "section_verse_max_bars": 25,
  "max_section_verse_examples": 90000,
  "strict_verse_artifact_filter": true,
  "tasks": [
    "generate_verse",
    "generate_clean_scene_verse",
    "generate_architectural_verse"
  ],
  "minimum_continuation_source_lines": 16,
  "continuation_split_line": 8,
  "verse_line_count": 12,
  "max_verse_examples_per_song": 4,
  "max_words_per_bar": 9,
  "theme_keyword_count": 6,
  "min_theme_keyword_matches": 1,
  "max_avg_words_per_bar": 11,
  "hard_max_words_per_bar": 16,
  "max_long_bar_ratio": 0.25,
  "clean_scene_line_count": 12,
  "max_clean_scene_examples_per_song": 1,
  "min_clean_scene_keyword_hits": 5,
  "min_unique_clean_scene_keywords": 2,
  "min_clean_scene_work_anchor_hits": 2,
  "min_unique_clean_scene_work_anchors": 2,
  "max_clean_scene_soft_drift_count": 0,
  "max_clean_scene_adlib_count": 0,
  "architecture_verse_line_count": 12,
  "max_architecture_verse_examples_per_song": 2,
  "task_repeat_counts": {
    "generate_clean_scene_verse": 80,
    "generate_architectural_verse": 20
  }
}
