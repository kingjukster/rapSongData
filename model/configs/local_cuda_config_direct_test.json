{
    "base_model":  "Qwen/Qwen2.5-7B-Instruct",
    "output_dir":  "data/run_logs/direct_test2/model/artifacts",
    "add_structural_special_tokens":  false,
    "dataset":  {
                    "train_path":  "data/sft/rap_generation_sft.jsonl",
                    "validation_path":  "data/sft/rap_generation_sft.jsonl",
                    "text_field":  "training_text"
                },
    "training":  {
                     "max_steps":  50,
                     "num_train_epochs":  1,
                     "learning_rate":  0.0002,
                     "sequence_length":  768,
                     "per_device_train_batch_size":  1,
                     "gradient_accumulation_steps":  4,
                     "lora_rank":  16,
                     "lora_alpha":  32,
                     "lora_dropout":  0.05,
                     "tokenize_num_proc":  1,
                     "dataloader_num_workers":  0,
                     "timing_log_steps":  10,
                     "save_steps":  250,
                     "save_total_limit":  2,
                     "gradient_checkpointing":  true,
                     "gradient_checkpointing_kwargs":  {
                                                           "use_reentrant":  false
                                                       },
                     "bf16":  true,
                     "load_in_4bit":  false,
                     "allow_tf32":  true,
                     "float32_matmul_precision":  "high",
                     "cudnn_benchmark":  true,
                     "attn_implementation":  "sdpa",
                     "enable_flash_sdp":  true,
                     "enable_mem_efficient_sdp":  true,
                     "optim":  "adamw_torch"
                 }
}
