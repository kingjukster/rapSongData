{
  "base_model": "Qwen/Qwen3-4B-Instruct-2507",
  "output_dir": "model/artifacts/qwen3-4b-speed-probe-bs4-gc-off",
  "add_structural_special_tokens": false,
  "dataset": {
    "train_path": "data/sft/rap_full_song_openai_sft_controlled_v2_train.jsonl",
    "validation_path": "data/sft/rap_full_song_openai_sft_controlled_v2_validation.jsonl",
    "format": "json",
    "text_field": "training_text",
    "cleaning_summary_path": "data/labels/rap_full_song_openai_sft_controlled_v2_summary.json"
  },
  "training": {
    "max_steps": 20,
    "num_train_epochs": 1,
    "learning_rate": 0.0002,
    "sequence_length": 384,
    "per_device_train_batch_size": 4,
    "gradient_accumulation_steps": 1,
    "lora_rank": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.05,
    "tokenize_num_proc": 6,
    "dataloader_num_workers": 0,
    "timing_log_steps": 5,
    "save_steps": 20,
    "save_total_limit": 1,
    "gradient_checkpointing": false,
    "bf16": true,
    "load_in_4bit": true,
    "allow_tf32": true,
    "float32_matmul_precision": "high",
    "cudnn_benchmark": true,
    "attn_implementation": "sdpa",
    "enable_flash_sdp": true,
    "enable_mem_efficient_sdp": true,
    "optim": "paged_adamw_8bit",
    "tokenized_cache_dir": "model/cache/tokenized_qwen3_4b_full_song_openai_controlled_v2_seq384"
  }
}
